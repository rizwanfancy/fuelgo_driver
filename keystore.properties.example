# Copy this file to "keystore.properties" (same folder as this file, i.e. the project
# root) to build signed release APKs locally with Android Studio / `gradlew assembleRelease`.
#
# "keystore.properties" itself is in .gitignore — never commit your real keystore
# password or the .keystore file to source control. This example file with placeholder
# values is safe to commit.
#
# storeFile is resolved relative to the project root (where this file lives).
storeFile=../keystore/fuelgo-release.keystore
storePassword=CHANGE_ME
keyAlias=fuelgo-driver
keyPassword=CHANGE_ME
