<?xml version="1.0" encoding="utf-8"?>
<!--
  This app's server address is user-configurable at runtime (see API Configuration),
  and for this project that address is a LAN-only .NET dev backend served over plain
  http:// with no real TLS certificate — there's no fixed hostname to scope an
  exception to. Cleartext is therefore permitted in both debug and release builds.

  If this app is ever pointed at a real internet-facing backend with a proper TLS
  certificate, switch back to cleartextTrafficPermitted="false" (or add a scoped
  <domain-config> for just that LAN case) so all other traffic stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
