<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override: allows plain HTTP (cleartext) so the app can talk to the
  FuelGo .NET API running on your PC (e.g. http://192.168.x.x:5086) while testing
  on the emulator or a physical device. This file never ships in a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
